"""
Repository-specific checks for the root Cargo workspace.

The generic Rust checks (build, test, clippy, doc, ...) run on a current
toolchain configured in `dagger.toml`. The checks here need a toolchain that
is derived from the workspace itself.
"""
type Schemaform {
  """
  Minimum supported Rust version declared by the workspace manifest.
  """
  rustVersion: String!

  let rust: Rust!

  new(
    ws: Workspace!,
    """
    Variant (image tag suffix) of the official Rust image to combine with the
    version taken from the workspace manifest, e.g. "trixie" or "slim-trixie".
    """
    imageVariant: String! = "trixie",
  ) {
    let manifest = TOML.decode(ws.file("/Cargo.toml").contents) :: Manifest!

    let version = manifest.workspace.package.rustVersion
    if (version == null) {
      raise "Cargo.toml does not declare rust-version under [workspace.package]"
    }

    self.rustVersion = version
    self.rust = Dagger.rust(ws, version: version + "-" + imageVariant)

    self
  }

  """
  Compile every workspace target on the minimum supported Rust version.

  Keeps the `rust-version` declared in Cargo.toml truthful: a newer toolchain
  in the other checks would otherwise accept syntax and library APIs the
  declared minimum cannot build.
  """
  msrv: String! @check {
    self
      .rust
      .container
      .withExec(["cargo", "check", "--workspace", "--all-targets", "--locked"])
      .stdout
  }
}

type Manifest {
  workspace: ManifestWorkspace!
}

type ManifestWorkspace {
  package: ManifestWorkspacePackage!
}

type ManifestWorkspacePackage {
  rustVersion: String @TOML.field(name: "rust-version")
}
