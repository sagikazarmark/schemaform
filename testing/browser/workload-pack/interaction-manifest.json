{
  "version": 1,
  "suite": "schemaform-dioxus/browser_csr",
  "browsers": [
    "chromium",
    "firefox",
    "webkit"
  ],
  "viewport_widths_css_pixels": [
    320,
    1280
  ],
  "zoom_percents": [
    100,
    200
  ],
  "zoom_protocol": "Set the Playwright CSS viewport to the requested width, apply CSS zoom to every mounted form root, and assert innerWidth equals the requested CSS width. Harness-owned nested viewport dimensions remain unscaled.",
  "accessibility": {
    "engine": "axe-core",
    "version": "4.10.3",
    "checkpoints": [
      {
        "id": "authored-ui",
        "trace": "authored_ui_schema_renders_semantics_and_preserves_form_behavior",
        "coverage": [
          "ui-control",
          "ui-stack",
          "ui-group",
          "ui-text",
          "help"
        ],
        "aria_required": [
          "textbox \"Localized second field\"",
          "Localized family-name help.",
          "group \"Localized primary details\""
        ]
      },
      {
        "id": "tabs-blocked",
        "trace": "tabs_support_keyboard_navigation_adapter_local_selection_and_summary_focus",
        "coverage": [
          "ui-tabs",
          "tabs",
          "blocked-submission"
        ],
        "aria_required": [
          "tablist \"Tabs\"",
          "tab \"Contact\" [selected]",
          "tabpanel \"Contact\"",
          "button \"Value does not satisfy minLength.\""
        ]
      },
      {
        "id": "grid",
        "trace": "responsive_grid_behavior_matches_the_active_css_viewport",
        "coverage": [
          "ui-grid"
        ],
        "aria_required": [
          "textbox \"First\"",
          "textbox \"Second\""
        ]
      },
      {
        "id": "auto",
        "trace": "explicit_auto_renders_only_at_its_authored_position",
        "coverage": [
          "ui-auto"
        ],
        "aria_required": [
          "paragraph: Generated fields",
          "textbox \"second\"",
          "paragraph: End fields"
        ]
      },
      {
        "id": "string",
        "trace": "generated_string_control_mounts_edits_and_submits_an_immutable_snapshot",
        "coverage": [
          "string-control"
        ],
        "aria_required": [
          "textbox \"Full name\": Ada",
          "textbox \"Full name\": Lin"
        ]
      },
      {
        "id": "array-scalar",
        "trace": "scalar_array_structural_actions_preserve_dom_identity_focus_and_announcements",
        "coverage": [
          "arrays"
        ],
        "aria_required": [
          "group \"Tags\"",
          "button \"Add Tags item\"",
          "status"
        ]
      },
      {
        "id": "array-object",
        "trace": "fixed_object_array_rows_edit_focus_localize_and_submit_in_the_browser",
        "coverage": [
          "arrays"
        ],
        "aria_required": [
          "group \"People\"",
          "group \"Person\"",
          "group \"Address\"",
          "City fallback help."
        ]
      },
      {
