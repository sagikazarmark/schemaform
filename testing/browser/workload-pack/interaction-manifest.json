        "coverage": [
          "read-only",
          "write-only"
        ],
        "aria_required": [
          "group \"profile\"",
          "status \"Name\": Ada",
          "textbox \"Replace Secret\"",
          "status \"Secret region\": Value is set"
        ]
      },
      {
        "id": "presence-missing",
        "trace": "scalar_presence_controls_repair_explicitly_without_render_time_mutation",
        "coverage": [
          "presence-missing"
        ],
        "aria_required": [
          "textbox \"Value\"",
          "button \"Set Value\""
        ]
      },
      {
        "id": "presence-empty",
        "trace": "scalar_presence_controls_repair_explicitly_without_render_time_mutation",
        "coverage": [
          "presence-empty"
        ],
        "aria_required": [
          "textbox \"Value\"",
          "button \"Remove Value\""
        ]
      },
      {
        "id": "presence-null",
