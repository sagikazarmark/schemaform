        "coverage": [
          "presence-incompatible"
        ],
        "aria_required": [
          "textbox \"Value\": \"7\"",
          "status: \"7\"",
          "button \"Replace Value\""
        ]
      },
      {
        "id": "presence-compatible",
        "trace": "scalar_presence_controls_repair_explicitly_without_render_time_mutation",
        "coverage": [
          "presence-compatible"
        ],
        "aria_required": [
          "textbox \"Value\"",
          "button \"Clear Value\""
        ]
      },
      {
        "id": "integer-parse-blocked",
        "trace": "arbitrary_precision_integer_browser_trace_matches_the_core_facade",
        "coverage": [
          "integer-control",
          "parse-findings",
          "blocked-submission"
        ],
        "aria_required": [
          "button \"Enter a valid integer.\"",
          "textbox \"Quantity\": \"-\""
        ]
      },
      {
        "id": "number-validation-blocked",
        "trace": "arbitrary_precision_decimal_browser_trace_matches_the_core_facade",
        "coverage": [
          "number-control",
          "validation-findings",
          "blocked-submission"
        ],
        "aria_required": [
          "button \"Value must be at least",
          "textbox \"Rate\": \"0.10000000000000000000000000000000000000009\""
        ]
      },
      {
        "id": "boolean-constant",
        "trace": "boolean_and_scalar_constant_controls_preserve_native_semantics",
        "coverage": [
          "boolean-control",
          "constant-control"
        ],
        "aria_required": [
          "checkbox \"Enabled\"",
          "status \"Region\": EU"
        ]
      },
      {
        "id": "choice",
        "trace": "finite_scalar_choices_use_opaque_tokens_and_submit_exact_values",
        "coverage": [
          "choice-control"
        ],
        "aria_required": [
          "combobox \"Choice\"",
          "option \"None\" [selected]",
          "status \"Region\": EU"
        ]
      },
      {
        "id": "unsupported",
        "trace": "unsupported_one_of_region_is_presented_and_blocks_browser_submission",
        "coverage": [
          "unsupported-regions",
          "capability-findings",
          "blocked-submission"
        ],
        "aria_required": [
          "region \"Contact\"",
          "button \"This form region cannot be edited because oneOf branch selection is unsupported.\""
        ]
      },
      {
        "id": "fixed-object",
        "trace": "optional_fixed_object_materializes_repairs_removes_and_submits_in_the_browser",
        "coverage": [
          "fixed-object-control"
        ],
        "aria_required": [
          "group \"Settings\"",
          "button \"Add Settings\"",
          "textbox \"Name\""
        ]
      },
      {
        "id": "external-parse-blocked",
        "trace": "external_visibility_parse_feedback_and_submission_focus_follow_core_policy",
        "coverage": [
          "external-findings",
          "parse-findings",
          "blocked-submission"
        ],
        "aria_required": [
          "button \"server reported server-retry-required.\"",
          "button \"Enter a valid integer.\"",
          "textbox \"Quantity\": \"-\""
        ]
      },
      {
        "id": "indeterminate-blocked",
        "trace": "indeterminate_validation_is_presented_and_blocks_browser_submission",
        "coverage": [
          "indeterminate-findings",
          "blocked-submission"
        ],
        "aria_required": [
          "button \"Validation could not be completed reliably.\"",
          "textbox \"Name\""
        ]
      }
    ],
    "reviewed_exceptions": []
  },
