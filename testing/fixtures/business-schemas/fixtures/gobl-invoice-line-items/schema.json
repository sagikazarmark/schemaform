{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemaform:corpus:gobl-invoice-line-items",
  "$comment": "Adapted and reduced from Invopop's Apache-2.0 GOBL Invoice Line schema; this file has been changed for offline corpus use.",
  "title": "Invoice line items",
  "description": "Repeatable invoice lines with nested discounts and calculated totals.",
  "type": "object",
  "required": ["lines"],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line" }
    },
    "subtotal": { "type": "number", "readOnly": true },
    "tax": { "type": "number", "readOnly": true }
  },
  "$defs": {
    "line": {
      "type": "object",
      "required": ["description", "quantity", "unitPrice"],
      "properties": {
        "description": { "type": "string" },
        "quantity": { "type": "number", "minimum": 0 },
        "unitPrice": { "type": "number", "minimum": 0 },
        "discounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["amount"],
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
