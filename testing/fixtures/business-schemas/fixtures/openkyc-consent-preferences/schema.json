{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemaform:corpus:openkyc-consent-preferences",
  "$comment": "Adapted and reduced from Lazy Jack Ltd's Apache-2.0 OpenKYCAML 1.19.0 KYCProfile and ConsentRecord definitions; this file has been changed for offline corpus use.",
  "title": "Consent records",
  "description": "A per-purpose GDPR consent audit trail.",
  "type": "object",
  "required": ["consentRecords"],
  "properties": {
    "consentRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/consentRecord" }
    }
  },
  "$defs": {
    "consentRecord": {
      "type": "object",
      "required": ["consentPurpose", "consentGiven", "consentDate"],
      "properties": {
        "consentPurpose": { "type": "string" },
        "consentGiven": { "type": "boolean" },
        "consentDate": { "type": "string", "format": "date-time" },
        "consentWithdrawnDate": { "type": "string", "format": "date-time" },
        "consentMethod": {
          "type": "string",
          "enum": ["WRITTEN", "ELECTRONIC", "VERBAL", "IMPLICIT", "OTHER"]
        },
        "consentReference": { "type": "string" },
        "legalBasis": {
          "type": "string",
          "enum": ["CONSENT", "CONTRACT", "LEGAL_OBLIGATION", "VITAL_INTERESTS", "PUBLIC_TASK", "LEGITIMATE_INTERESTS"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
