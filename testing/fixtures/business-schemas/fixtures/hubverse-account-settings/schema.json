{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemaform:corpus:hubverse-account-settings",
  "$comment": "Adapted and reduced from the CC0-1.0 hubverse Admin Schema 5.1.0; this file has been changed for offline corpus use.",
  "title": "Hub administration settings",
  "description": "Maintainers, repository settings, accepted formats, timezone, and cloud configuration.",
  "type": "object",
  "required": ["maintainers", "repository", "timezone"],
  "properties": {
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        },
        "additionalProperties": false
      }
    },
    "repository": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "branch": { "type": "string", "default": "main" }
      },
      "additionalProperties": false
    },
    "timezone": { "type": "string", "enum": ["UTC", "US/Eastern", "US/Pacific", "Europe/London"] },
    "acceptedFormats": {
      "type": "array",
      "items": { "type": "string", "enum": ["csv", "parquet", "json"] }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["aws", "azure", "gcp"] },
        "bucket": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
