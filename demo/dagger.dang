type Demo {
  let dioxus: Dioxus!

  """
  The Playwright + axe project under `e2e/`.
  """
  let e2e: Directory!

  """
  The Playwright version `e2e/package.json` pins; the browser image must ship the same one.
  """
  let playwrightVersion: String!

  new(
    ws: Workspace!,
    rustVersion: String!,
    nodeVersion: String! = "latest",
    envFile: File,
  ) {
    self.e2e = ws.directory("e2e", gitignore: true)
    self.playwrightVersion = (
      JSON.decode(ws.file("e2e/package.json").contents) :: NpmManifest!
    ).devDependencies.playwright

    # clang is needed to cross-compile the C sysroot pulled in
    # by the `dioxus-code` snippet highlighter (arborium/tree-sitter) for the wasm32 target.
    # The `cc` crate auto-selects clang for wasm32-unknown-unknown, so installing it is enough.
    let rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "clang"])

    let node = Dagger
      .container
      .from("node:" + nodeVersion)
      .{ withNpmCache(_) }
      .withWorkdir("/work/src")
      .withMountedDirectory("", ws.directory("", gitignore: true))
      .withExec(["npm", "install"])

    let assets = node
      .withExec(["npm", "run", "build"])
      .directory("assets")
      .filter(include: ["style.css"])

    ws = ws.withDirectory("assets", assets)

    self.dioxus = Dagger.dioxus(
      ws: ws,
      container: rustContainer,
      envFile: envFile,
    )

    self
  }

  """
  Build the demo application.
  """
  build: Directory! @check {
    self
      .dioxus
      .bundle(
        release: true,
        debugSymbols: false,
      )
  }

  """
  Run the demo's native tests.

  The gallery's example data schemas and the `schemaform_daisyui` tests in
  `tests/schemaform_daisyui/` (binding round trips, the errors/invalid
  partition, renderer selection, and the control, collection, shell, and
  finding-presenter markup) run here; the wasm bundle above never executes them.
  """
  test: String! @check {
    self
      .dioxus
      .container
      .withExec(["cargo", "test", "--locked"])
      .stdout
  }

  """
  Serve the demo application.
  """
  service: Service! @up {
    self.dioxus.serve(
      release: true,
      debugSymbols: false,
    )
  }

  """
  Drive the daisyUI-rendered pages of the built demo in a browser and hold them to zero axe violations.

  Playwright opens the bundle `build` produces, walks `/daisyui` (and the RTL
  variant) and `/arrays` through named checkpoints in the light and dark themes
  running axe-core at each, exercises finding-summary focus-to-target and
  presence repair on the daisyUI-rendered controls, and add, insert, move, and
  remove with their focus and announcements on the daisyUI-rendered arrays. The
  browser image is the one matching the Playwright version `e2e/package.json`
  pins. See `e2e/README.md`.
  """
  accessibility: String! @check {
    Dagger
      .container
      .from("mcr.microsoft.com/playwright:v" + self.playwrightVersion + "-noble")
      .{ withNpmCache(_) }
      .withWorkdir("/work/e2e")
      .withMountedDirectory("", self.e2e)
      .withExec(["npm", "ci"])
      .withMountedDirectory("/work/site", self.build.directory("public"))
      .withExec(["node", "daisyui.mjs", "--site", "/work/site", "--out", "/work/artifacts"])
      .stdout
  }

  workerBundle: Directory! @check {
    let client = self
      .dioxus
      .bundle(
        release: true,
        debugSymbols: false,
        platform: DioxusPlatform.WEB,
      )

    Dagger
      .directory
      .withDirectory("dist", client)
  }

  workerBundleAsContainer: Container! {
    Dagger.container.withDirectory("", self.workerBundle)
  }
}

"""
Share one npm download cache between the containers that run npm.
"""
let withNpmCache(container: Container!): Container! {
  container
    .withEnvVariable("NPM_CONFIG_CACHE", "/root/.npm")
    .withMountedCache("${NPM_CONFIG_CACHE}", Dagger.cacheVolume("npm"), expand: true)
}

"""
The parts of an npm `package.json` the module reads.
"""
type NpmManifest {
  devDependencies: NpmDevDependencies!
}

type NpmDevDependencies {
  playwright: String!
}
