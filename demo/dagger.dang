type Demo {
  let dioxus: Dioxus!

  new(
    ws: Workspace!,
    rustVersion: String!,
    nodeVersion: String! = "latest",
    envFile: File,
  ) {
    # clang is needed to cross-compile the C sysroot pulled in
    # by the `dioxus-code` snippet highlighter (arborium/tree-sitter) for the wasm32 target.
    # The `cc` crate auto-selects clang for wasm32-unknown-unknown, so installing it is enough.
    let rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "clang"])

    let node = Dagger
      .container
      .from("node:" + nodeVersion)
      .withEnvVariable("NPM_CONFIG_CACHE", "/root/.npm")
      .withMountedCache("${NPM_CONFIG_CACHE}", Dagger.cacheVolume("npm"), expand: true)
      .withWorkdir("/work/src")
      .withMountedDirectory("", ws.directory("", gitignore: true))
      .withExec(["npm", "install"])

    let assets = node
      .withExec(["npm", "run", "build"])
      .directory("assets")
      .filter(include: ["style.css"])

    ws = ws.withDirectory("assets", assets)

    self.dioxus = Dagger.dioxus(
      ws: ws,
      container: rustContainer,
      envFile: envFile,
    )

    self
  }

  """
  Build the demo application.
  """
  build: Directory! @check {
    self
      .dioxus
      .bundle(
        release: true,
        debugSymbols: false,
      )
  }

  """
  Run the demo's native tests.

  The gallery's example data schemas and the `schemaform_daisyui` mapping tests
  (binding round trips, the errors/invalid partition, renderer selection) run
  here; the wasm bundle above never executes them.
  """
  test: String! @check {
    self
      .dioxus
      .container
      .withExec(["cargo", "test", "--locked"])
      .stdout
  }

  """
  Serve the demo application.
  """
  service: Service! @up {
    self.dioxus.serve(
      release: true,
      debugSymbols: false,
    )
  }

  workerBundle: Directory! @check {
    let client = self
      .dioxus
      .bundle(
        release: true,
        debugSymbols: false,
        platform: DioxusPlatform.WEB,
      )

    Dagger
      .directory
      .withDirectory("dist", client)
  }

  workerBundleAsContainer: Container! {
    Dagger.container.withDirectory("", self.workerBundle)
  }
}


